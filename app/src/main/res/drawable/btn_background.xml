<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <shape>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/vh_primary"
                android:endColor="@color/vh_fuchsia" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/enabledGray" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
