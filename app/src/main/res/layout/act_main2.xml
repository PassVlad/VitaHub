<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/ActionBar"
            app:title="@string/title"
            app:menu="@menu/main_menu"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_medical"
            android:layout_marginBottom="24dp">

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Заголовок с иконкой -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_glucose"
                android:layout_marginEnd="12dp"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selectAct"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_glucoza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btnGlu"
                style="@style/ModernButton"
                app:autoSizeTextType="uniform"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/white"
                android:alpha="0.3"/>

            <Button
                android:id="@+id/btn_press"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btnPress"
                style="@style/ModernButton"
                app:autoSizeTextType="uniform"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="10dp"
                android:background="@color/white"
                android:alpha="0.3"/>

            <Button
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btnPress"
                style="@style/ModernButton"
                app:autoSizeTextType="uniform"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>